# Copy this file to .env and set local values. Never commit .env.
POSTGRES_DB=winter_olympics
DATABASE_USERNAME=olympics
DATABASE_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=jdbc:postgresql://localhost:5434/winter_olympics
POSTGRES_PORT=5434

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Required only when the admin account does not yet exist.
ADMIN_INITIAL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8081
